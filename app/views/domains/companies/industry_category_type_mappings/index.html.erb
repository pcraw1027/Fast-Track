<h3>Industry Category Type Mappings</h3>

  <div class="row">
      <div class="card mb-6">
        <div class="card-body">
          <h5 class="card-title">Import Category Code</h5>

          <%= form_with url: upload_linkedin_v_data_domains_companies_industry_category_types_path, multipart: true, local: true do |f| %>
            <div class="row">
            <div class="form-group mb-3">
              <%= f.label :file, "Select CSV File", class: "form-label" %>
              <%= f.file_field :file, accept: ".csv", class: "form-control-file", required: true %>
            </div>

            <div class="form-group mb-3">
              <%= f.submit "Import", class: "btn btn-primary" %>
            </div>
            
            </div>
          <% end %>
        </div>
      </div>

      <div class="card mb-6">
        <div class="card-body">
          <h5 class="card-title">Import Category Code Mappings</h5>

          <%= form_with url: upload_linkedin_mappings_domains_companies_industry_category_types_path, multipart: true, local: true do |f| %>
             <div class="row">
            <div class="form-group mb-3">
              <%= f.label :file, "Select CSV File", class: "form-label" %>
              <%= f.file_field :file, accept: ".csv", class: "form-control-file", required: true %>
            </div>

            <div class="form-group mb-3">
              <%= f.submit "Import", class: "btn btn-primary" %>
            </div>
            
            </div>
          <% end %>
        </div>
      </div>
  </div>


<table class="table table-striped table-bordered table-hover table-sm">
  <thead class="thead-dark">
    <tr>
    <th>Mapping Type</th>
    <th>Category Code Type From </th>
     <th>Category Code Type From ID </th>
      <th>Category Code Type To </th>
       <th>Category Code Type To ID</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @industry_category_type_mappings.each do |mapping| %>
      <tr>
      <td><%= mapping.mapping_type&.titleize %></td>
      <td><%= mapping.category_code_type_from&.title || "" %></td>
      <td><%= mapping.category_code_type_from_id %></td>
        <td><%= mapping.category_code_type_to&.title || "" %></td>
        <td><%= mapping.category_code_type_to_id %></td>
        <td><%= link_to 'Show', mapping %></td>
        <td><%= link_to 'Edit', edit_domains_companies_industry_category_type_mapping_path(mapping) %></td>
        <td><%= button_to 'Delete', mapping, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-outline-danger btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<nav aria-label="Page navigation" class="pagination-form">
  <%= will_paginate @industry_category_type_mappings, renderer: BootstrapPagination::Rails, class: 'pagination justify-content-center' %>

  <form method="get" action="/domains/companies/industry_category_type_mappings">
    <div class="form-group">
      <input name="page" class="ml-2 jumpto-field" type="number" placeholder="Page #"/>
      <input class="btn btn-outline-success" type="submit" value="Goto page" />
    </div>
  </form>
</nav>

<%= link_to 'New Industry Category Type Mapping', new_domains_companies_industry_category_type_mapping_path, class: "action-btn" %>